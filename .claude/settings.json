{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run build-prod:*)",
      "Bash(npm run watch:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npm ls:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(node -e:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)",
      "Read(./.angular/**)",
      "Read(./package-lock.json)"
    ]
  }
}
